node_modules/
dist/

# Fetched or copied by `npm run assets` (see scripts/fetch-assets.mjs).
# ~26 MB of wasm and model weights — reproducible, so not worth committing.
public/mediapipe/
public/models/

# Stray renders saved at the root while trying something out.
/*.png

*.log
.DS_Store

# Recordings the app saves while running locally. The developer copies the
# ones worth keeping into test/fixtures/ with the change they motivated.
test/fixtures/sessions/

# Evidence written by failing checks. The goldens themselves, in test/golden/,
# are committed; the /*.png rule above is root-only and does not touch them.
test/out/

# What the sculpt scripts derive from the drawing. `python3 scripts/sculpt/depth.py`
# rebuilds it; the drawing is the source, these are megabytes of cache.
__pycache__/
scripts/sculpt/out/
