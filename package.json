{
  "name": "vtuber-model",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Webcam-driven VTuber avatar. Face tracking in the browser, OBS-ready output.",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
