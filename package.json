{
  "name": "vtuber-model",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Webcam-driven VTuber avatar. Face tracking in the browser, OBS-ready output.",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "phone": "node scripts/phone.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node test/rig.mjs && node test/parts.mjs && node test/motion.mjs && node test/smoke.mjs && node test/mobile.mjs && node test/warp.mjs",
    "test:rig": "node test/rig.mjs",
    "test:parts": "node test/parts.mjs",
    "test:motion": "node test/motion.mjs",
    "test:mobile": "node test/mobile.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:warp": "node test/warp.mjs",
    "warp-demo": "node scripts/visual/warp-demo.mjs warp-demo.png",
    "closeup": "node scripts/visual/closeup.mjs closeup.png",
    "parts": "node scripts/visual/parts.mjs parts.png",
    "puppet": "node scripts/visual/puppet.mjs puppet.png",
    "scarf": "node scripts/visual/scarf.mjs scarf.png",
    "arms": "node scripts/visual/arms.mjs arms.png",
    "motion": "node scripts/visual/motion.mjs motion.png"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright": "^1.56.1",
    "vite": "^7.1.14"
  }
}
