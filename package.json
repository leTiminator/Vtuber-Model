{
  "name": "vtuber-model",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Webcam-driven VTuber avatar. Face tracking in the browser, OBS-ready output.",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node test/run-all.mjs",
    "test:rig": "node test/rig.mjs",
    "test:parts": "node test/parts.mjs",
    "test:replay": "node test/replay.mjs",
    "test:smoke": "node test/smoke.mjs",
    "parts": "node scripts/visual/parts.mjs parts.png",
    "puppet": "node scripts/visual/puppet.mjs puppet.png",
    "scarf": "node scripts/visual/scarf.mjs scarf.png",
    "arms": "node scripts/visual/arms.mjs arms.png",
    "motion": "node scripts/visual/motion.mjs motion.png",
    "dynamics": "node scripts/visual/dynamics.mjs dynamics.png",
    "faces": "node scripts/visual/faces.mjs faces.png",
    "test:output": "node test/output.mjs",
    "test:golden": "node test/golden.mjs",
    "test:invariants": "node test/invariants.mjs",
    "test:cloth": "node test/cloth.mjs",
    "bake": "node scripts/bake-model.mjs",
    "bake:check": "node scripts/bake-model.mjs --check",
    "test:model": "node test/model.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "vite": "^7.1.14",
    "ws": "^8.21.3"
  }
}
